--!nocheck
return function()
	local Guard = require(script.Parent.Guard)

	describe("Guard.string", function()
		it("accepts strings within the limit", function()
			expect((Guard.string(5)("abc"))).to.equal(true)
		end)
		it("rejects non-strings and oversized strings", function()
			expect((Guard.string(5)(123))).to.equal(false)
			expect((Guard.string(5)("abcdef"))).to.equal(false)
			expect((Guard.string()(string.rep("x", 201)))).to.equal(false)
		end)
	end)

	describe("Guard.number and Guard.integer", function()
		it("rejects NaN and infinity", function()
			expect((Guard.number()(0 / 0))).to.equal(false)
			expect((Guard.number()(math.huge))).to.equal(false)
			expect((Guard.number()(-math.huge))).to.equal(false)
		end)
		it("enforces ranges", function()
			expect((Guard.number(0, 10)(5))).to.equal(true)
			expect((Guard.number(0, 10)(-1))).to.equal(false)
			expect((Guard.number(0, 10)(11))).to.equal(false)
		end)
		it("integer rejects fractions", function()
			expect((Guard.integer()(3))).to.equal(true)
			expect((Guard.integer()(3.5))).to.equal(false)
		end)
	end)

	describe("Guard.oneOf", function()
		it("only accepts listed values", function()
			local validator = Guard.oneOf({ "Basic", "Royal" })
			expect((validator("Basic"))).to.equal(true)
			expect((validator("Mythic"))).to.equal(false)
			expect((validator(nil))).to.equal(false)
		end)
	end)

	describe("Guard.optional", function()
		it("passes nil through and validates non-nil", function()
			local validator = Guard.optional(Guard.integer(1, 10))
			expect((validator(nil))).to.equal(true)
			expect((validator(5))).to.equal(true)
			expect((validator(50))).to.equal(false)
		end)
	end)

	describe("Guard.table and Guard.arrayOf", function()
		it("blocks oversized tables", function()
			local big = {}
			for index = 1, 100 do
				big[index] = true
			end
			expect((Guard.table(50)(big))).to.equal(false)
			expect((Guard.table(50)({ a = 1 }))).to.equal(true)
		end)
		it("validates each array element", function()
			local validator = Guard.arrayOf(Guard.integer(1, 100), 3)
			expect((validator({ 1, 2, 3 }))).to.equal(true)
			expect((validator({ 1, "two" }))).to.equal(false)
			expect((validator({ 1, 2, 3, 4 }))).to.equal(false)
			expect((validator({ [true] = 1 }))).to.equal(false)
		end)
	end)

	describe("Guard.checkArgs", function()
		it("validates a tuple in order", function()
			local schema = { Guard.string(20), Guard.integer(1, 5) }
			expect((Guard.checkArgs(schema, "Basic", 3))).to.equal(true)
			expect((Guard.checkArgs(schema, "Basic", 9))).to.equal(false)
			expect((Guard.checkArgs(schema, 3, "Basic"))).to.equal(false)
		end)
		it("rejects missing and extra arguments", function()
			local schema = { Guard.string(20) }
			expect((Guard.checkArgs(schema))).to.equal(false)
			expect((Guard.checkArgs(schema, "ok", "extra"))).to.equal(false)
		end)
		it("rejects nil holes in the middle of a tuple", function()
			local schema = { Guard.string(20), Guard.integer(), Guard.string(20) }
			expect((Guard.checkArgs(schema, "a", nil, "c"))).to.equal(false)
		end)
	end)
end
